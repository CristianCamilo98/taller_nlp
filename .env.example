# Copia este fichero a .env (en la RAIZ del repo, junto a este ejemplo) y
# rellena con tu clave real de OpenRouter. El código carga .env desde la
# raíz del repo (ver common/agent/agent.py y
# common/retrieval/openrouter_embeddings.py); .env está en .gitignore y
# nunca debe llevarse a Git. No pongas aquí ninguna clave real.
OPENROUTER_API_KEY=

# Opcional. El dataset runtime minimo (perfil gemini-embedding-2) ya viene
# incluido en el repo en dataset/, por lo que esta variable NO es necesaria
# para la ejecucion normal. Solo hace falta como override si quieres apuntar
# a otra copia del dataset (por ejemplo, para probar un perfil de retrieval
# historico no incluido en el repo).
# MIAX_DATASET_DIR=
